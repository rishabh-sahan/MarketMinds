# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
SARVAM_API_KEY=
OPENROUTER_API_KEY=

# Reddit sentiment (optional). Reddit blocks ALL unauthenticated API traffic,
# so the Sentiment Analyst skips Reddit unless these are set. Create a
# "script" app at https://www.reddit.com/prefs/apps to get the ID and secret.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
#REDDIT_USER_AGENT=python:marketminds:v0.2 (by /u/your_username)

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code.
# Any MARKETMINDS_* variable below, when set, replaces the matching key
# in marketminds/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
#MARKETMINDS_LLM_PROVIDER=openai
#MARKETMINDS_DEEP_THINK_LLM=gpt-5.4
#MARKETMINDS_QUICK_THINK_LLM=gpt-5.4-mini
#MARKETMINDS_LLM_BACKEND_URL=
#MARKETMINDS_OUTPUT_LANGUAGE=English
#MARKETMINDS_MAX_DEBATE_ROUNDS=1
#MARKETMINDS_MAX_RISK_ROUNDS=1
#MARKETMINDS_CHECKPOINT_ENABLED=false
