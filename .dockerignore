# Keep the build context small and the image reproducible: everything below is
# either rebuilt inside the image, host-specific, or must never be baked in.

# Python virtualenvs and build artefacts
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# Node — reinstalled from the lockfile in the build stage
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# Secrets and local state. API keys are passed at run time, never baked in.
.env
.env.*
!.env.example
*.db
*.sqlite
*.sqlite3
backend/marketminds.db

# VCS, editors, OS cruft
.git/
.gitignore
.github/
.vscode/
.idea/
.claude/
*.swp
.DS_Store
Thumbs.db

# Docs and local notes that do not affect the runtime
Notes.txt
uv.lock
