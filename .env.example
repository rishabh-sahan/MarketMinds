# MarketMinds configuration. Copy to .env and fill in what you need.
#
#   cp .env.example .env
#
# Only an LLM provider key is required. Everything else has a working default.
# .env is gitignored — keep it that way.


# --- LLM providers ---------------------------------------------------------
# Set the one you use. Visitors can also supply their own key in the browser,
# which is used for their run alone and never stored on the server.

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
SARVAM_API_KEY=
OPENROUTER_API_KEY=

# Caps completion length on OpenRouter, whose free models often advertise a
# larger window than they will actually generate.
#OPENROUTER_MAX_TOKENS=4096


# --- Market data (optional) ------------------------------------------------
# Only needed if you switch a data vendor to Alpha Vantage. The default Indian
# sources (Yahoo Finance, Google News India, NSE filings) need no key at all.

#ALPHA_VANTAGE_API_KEY=


# --- Database --------------------------------------------------------------
# Unset means SQLite at backend/marketminds.db — fine locally.
# Set this for any deployment, whose disk does not survive a restart.
# Supabase: Project Settings > Database > Connection string > URI.
# Prefer the Session pooler URI; the direct host is IPv6-only.

DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres


# --- Google sign-in --------------------------------------------------------
# Both set: sign-in is required to start a run, and each user's runs are
# private to them. Both unset: the instance runs open — right locally, wrong
# on a public URL. Needs the Google provider enabled in Supabase first
# (see DEPLOYMENT.md). Neither value is secret; both reach the browser.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx


# --- Behaviour overrides ---------------------------------------------------
# Any MARKETMINDS_* variable replaces the matching key in
# marketminds/default_config.py, coerced to that key's type.

#MARKETMINDS_LLM_PROVIDER=google
#MARKETMINDS_DEEP_THINK_LLM=gemini-3-flash-preview
#MARKETMINDS_QUICK_THINK_LLM=gemini-3-flash-preview
#MARKETMINDS_OUTPUT_LANGUAGE=English
#MARKETMINDS_MAX_DEBATE_ROUNDS=1
#MARKETMINDS_MAX_RISK_ROUNDS=1
#MARKETMINDS_CHECKPOINT_ENABLED=false
